{
  "name": "MPV WebLab · Cookie Sync",
  "description": "Locally refreshes YouTube and Bilibili cookie files for MPV WebLab.",
  "version": "0.5.3",
  "manifest_version": 3,
  "key": "",
  "permissions": [
    "cookies",
    "alarms",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "*://youtube.com/*",
    "*://*.youtube.com/*",
    "*://bilibili.com/*",
    "*://*.bilibili.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "MPV WebLab Cookie Sync",
    "default_popup": "status.html"
  }
}
